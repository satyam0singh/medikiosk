# ==========================================
# MediKiosk Environment Configuration
# ==========================================

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# PostgreSQL Configuration
DATABASE_URL=postgresql://medikiosk_user:medikiosk_password@localhost:5432/medikiosk_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medikiosk_db
DB_USER=medikiosk_user
DB_PASSWORD=medikiosk_password
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL_SECONDS=86400

# MinIO / Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=medikiosk_minio_admin
MINIO_SECRET_KEY=medikiosk_minio_secret_key
MINIO_BUCKET_DOCUMENTS=medikiosk-documents
MINIO_BUCKET_AUDIO=medikiosk-audio

# Security & Authentication
JWT_SECRET=super_secret_jwt_dev_key_change_in_production_min_32_bytes_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_32_bytes
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI Providers Configuration
# Provider options: mock | indicconformer | whisper | tesseract | openai | gemini | anthropic | azure
ASR_PROVIDER=mock
ASR_API_URL=http://localhost:8001/asr
ASR_API_KEY=

TTS_PROVIDER=mock
TTS_API_URL=http://localhost:8002/tts
TTS_API_KEY=

OCR_PROVIDER=mock
OCR_API_URL=http://localhost:8003/ocr
OCR_API_KEY=

LLM_PROVIDER=mock
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

NER_PROVIDER=mock
NER_API_URL=http://localhost:8004/ner
NER_API_KEY=

# Interoperability / FHIR Configuration
FHIR_MODE=mock
FHIR_BASE_URL=http://localhost:8080/fhir
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Logging & Audit
LOG_LEVEL=info
ENABLE_PHI_MASKING=true
AUDIT_LOG_ENABLED=true
