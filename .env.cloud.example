# ============================================================================
# MediKiosk Cloud Production / Remote Server Configuration
# ============================================================================

# Environment & Server
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=https://your-kiosk-app.vercel.app,https://your-doctor-portal.vercel.app,http://localhost:3000,http://localhost:3001

# ============================================================================
# 1. Cloud PostgreSQL (Neon / Supabase / AWS RDS / Railway / Aiven / Render)
# ============================================================================
# If DATABASE_URL is set, it takes priority over individual DB_* variables.
# SSL is automatically enabled for all remote cloud providers.
# Example Neon: postgresql://neondb_owner:password@ep-cool-cloud.us-east-2.aws.neon.tech/medikiosk_db?sslmode=require
# Example Supabase: postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# ============================================================================
# 2. Cloud Redis (Upstash / Redis Cloud / AWS ElastiCache / Railway)
# ============================================================================
# If REDIS_URL is set, it takes priority over REDIS_HOST / REDIS_PORT.
# rediss:// enables TLS encryption automatically for cloud providers.
# Example Upstash: rediss://default:password@us1-quiet-slug-12345.upstash.io:6379
# Example Redis Cloud: redis://default:password@redis-12345.c1.us-east-1-2.ec2.redislabs.com:12345
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379

# ============================================================================
# 3. Cloud Object Storage (AWS S3 / Cloudflare R2 / DigitalOcean Spaces / MinIO)
# ============================================================================
# AWS S3: MINIO_ENDPOINT=s3.us-east-1.amazonaws.com, MINIO_PORT=443, MINIO_USE_SSL=true
# Cloudflare R2: MINIO_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com, MINIO_PORT=443, MINIO_USE_SSL=true
MINIO_ENDPOINT=s3.us-east-1.amazonaws.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=YOUR_AWS_OR_R2_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_AWS_OR_R2_SECRET_KEY
MINIO_BUCKET_DOCUMENTS=medikiosk-documents
MINIO_BUCKET_AUDIO=medikiosk-audio

# ============================================================================
# 4. Security & JWT
# ============================================================================
JWT_SECRET=your_32_character_super_secure_jwt_production_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_32_character_refresh_token_production_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ============================================================================
# 5. AI & LLM Providers (Groq / OpenAI / Bhashini)
# ============================================================================
ASR_PROVIDER=bhashini
TTS_PROVIDER=bhashini
OCR_PROVIDER=groq
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_FALLBACK_1=your_groq_api_key_fallback_1
GROQ_API_KEY_FALLBACK_2=your_groq_api_key_fallback_2

# ============================================================================
# 6. Frontend Cloud Endpoint (.env in apps/kiosk-web and apps/doctor-dashboard)
# ============================================================================
# Set this on your deployed frontend (e.g. in Vercel / Netlify environment variables)
# VITE_API_URL=https://your-backend-api.onrender.com
